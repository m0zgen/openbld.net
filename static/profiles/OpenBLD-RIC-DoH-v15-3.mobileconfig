<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>

                <key>ServerURL</key>
                <string>https://ric.openbld.net/dns-query</string>
            </dict>

            <key>PayloadDescription</key>
            <string>Configures device to use OpenBLD.net RIC encrypted DNS over HTTPS</string>

            <key>PayloadDisplayName</key>
            <string>OpenBLD.net RIC DNS over HTTPS</string>

            <key>PayloadIdentifier</key>
            <string>com.apple.dnsSettings.managed.openbld.ric.doh</string>

            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>

            <key>PayloadUUID</key>
            <string>5AE99391-8947-44BD-A4A2-91682AA56B5F</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>ProhibitDisablement</key>
            <false/>
        </dict>
    </array>

    <key>PayloadDescription</key>
    <string>Configures OpenBLD.net RIC encrypted DNS over HTTPS on Apple devices</string>

    <key>PayloadDisplayName</key>
    <string>OpenBLD.net RIC DNS over HTTPS</string>

    <key>PayloadIdentifier</key>
    <string>net.openbld.ric.doh</string>

    <key>PayloadRemovalDisallowed</key>
    <false/>

    <key>PayloadScope</key>
    <string>System</string>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadUUID</key>
    <string>D78C8E71-7F45-46D8-BA48-9B55D83CDB80</string>

    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
